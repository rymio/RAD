10 REM *** STAR CATCH ***
20 REM JOYSTICK IN PORT 2, OR Z AND X
30 PRINT "{CLR}";:POKE 53280,6:POKE 53281,0
40 S=0:L=3:X=18:V=1024:C=55296
50 GOSUB 400
60 SX=INT(RND(1)*38)+1:SY=2
70 J=PEEK(56320):K=PEEK(197):OX=X
80 IF ((J AND 4)=0 OR K=12) AND X>0 THEN X=X-1
90 IF ((J AND 8)=0 OR K=23) AND X<37 THEN X=X+1
100 IF OX<>X THEN POKE V+920+OX,32:POKE V+921+OX,32:POKE V+922+OX,32
110 GOSUB 300
120 POKE V+SY*40+SX,32:SY=SY+1
130 IF SY=23 THEN GOSUB 200:GOTO 60
140 POKE V+SY*40+SX,42:POKE C+SY*40+SX,7
150 GOTO 70
200 REM THE STAR REACHED THE BOTTOM
210 IF SX>=X AND SX<=X+2 THEN S=S+1:GOSUB 400:RETURN
220 L=L-1:GOSUB 400:IF L>0 THEN RETURN
230 PRINT "{HOME}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}{DOWN}";
240 PRINT TAB(15);"{YELLOW}GAME OVER!"
250 FOR I=1 TO 3000:NEXT:RUN
300 REM DRAW THE CATCHER
310 POKE V+920+X,60:POKE V+921+X,61:POKE V+922+X,62
320 POKE C+920+X,1:POKE C+921+X,1:POKE C+922+X,1
330 RETURN
400 PRINT "{HOME}{WHITE}STAR CATCH    SCORE";S;"   LIVES";L;" "
410 RETURN
