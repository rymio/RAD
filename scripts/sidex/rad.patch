--- a/src-tauri/src/lib.rs
+++ b/src-tauri/src/lib.rs
@@ -432,6 +432,49 @@ fn fix_macos_path() {
 
 #[cfg_attr(mobile, tauri::mobile_entry_point)]
 #[allow(clippy::too_many_lines)]
+/// RAD: the folder to open, from `--folder PATH` (how RAD launches SideX).
+fn rad_folder_arg(args: &[String]) -> Option<std::path::PathBuf> {
+    let i = args.iter().position(|a| a == "--folder")?;
+    let p = std::path::PathBuf::from(args.get(i + 1)?);
+    p.is_dir().then_some(p)
+}
+
+/// RAD: shows `folder` — in the window that already has it, in the main window if that has
+/// no folder yet, or in a new window.
+fn rad_open_folder(app: &tauri::AppHandle, folder: &std::path::Path) {
+    let Some(main) = app.get_webview_window("main") else { return };
+    let Ok(mut url) = main.url() else { return };
+    let Ok(uri) = tauri::Url::from_file_path(folder) else { return };
+    let has_folder = url.query_pairs().any(|(k, _)| k == "folder");
+    url.query_pairs_mut().clear().append_pair("folder", uri.as_str());
+    for w in app.webview_windows().into_values() {
+        if w.url().ok().as_ref() == Some(&url) {
+            let _ = w.unminimize();
+            let _ = w.set_focus();
+            return;
+        }
+    }
+    if !has_folder {
+        let _ = main.navigate(url);
+        let _ = main.show();
+        let _ = main.set_focus();
+        return;
+    }
+    let label = format!("rad-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0));
+    let title = folder.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_else(|| "SideX".into());
+    let builder = tauri::WebviewWindowBuilder::new(app, &label, tauri::WebviewUrl::External(url))
+        .title(&title)
+        .inner_size(1280.0, 800.0)
+        .min_inner_size(800.0, 600.0);
+    #[cfg(target_os = "macos")]
+    let builder = builder.title_bar_style(tauri::TitleBarStyle::Overlay).hidden_title(true);
+    #[cfg(not(target_os = "macos"))]
+    let builder = builder.decorations(false).shadow(true);
+    if let Ok(w) = builder.build() {
+        let _ = w.set_focus();
+    }
+}
+
 pub fn run() {
     // Inherit the user's login-shell PATH before anything (terminals, git,
     // LSP servers, extension hosts) is spawned.
@@ -449,6 +492,18 @@ pub fn run() {
     }
 
     tauri::Builder::default()
+        // RAD: one SideX; launching it again with --folder opens that folder in it.
+        .plugin(tauri_plugin_single_instance::init(|app, argv, _cwd| {
+            match rad_folder_arg(&argv) {
+                Some(folder) => rad_open_folder(app, &folder),
+                None => {
+                    if let Some(w) = app.get_webview_window("main") {
+                        let _ = w.show();
+                        let _ = w.set_focus();
+                    }
+                }
+            }
+        }))
         .plugin(tauri_plugin_dialog::init())
         .plugin(tauri_plugin_shell::init())
         .manage(AuthState::new())
@@ -577,6 +632,9 @@ pub fn run() {
             };
 
             restore_and_show(app, &db);
