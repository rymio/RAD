[Unit]
Description=rymnetd - Rymnet daemon (peer node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rymnet
Group=rymnet
ExecStart=/usr/local/bin/rymnetd --data-dir /home/rymnet/.rymnet run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/rymnet/.rymnet

[Install]
WantedBy=multi-user.target
