# /etc/rad/rad-server.env — read by rad-server.service
# (chmod 600, owned by root; no secrets are needed here)

# The encrypted vault (created from the RAD app on first connect).
RAD_VAULT=/var/lib/rad/personal.radvault

# Behind nginx: listen on loopback only. nginx terminates HTTPS.
RAD_LISTEN=127.0.0.1:8765

# Name shown in the apps.
RAD_NAME=RAD server

# Encrypted daily backups (safe to sync off-site, e.g. with rclone).
RAD_BACKUP_DIR=/var/lib/rad/backups

# Must match client_max_body_size in the nginx site.
RAD_MAX_UPLOAD_MB=8192

# ffmpeg for MP3/MP4 transcription (apt install ffmpeg).
RAD_FFMPEG=/usr/bin/ffmpeg

# Built-in embedding model (nomic-embed-text v1.5, GGUF, ~146 MB). Downloaded once on first
# start if it isn't here yet, then works offline. Defaults to <vault folder>/models.
RAD_MODELS_DIR=/var/lib/rad/models

# Log level.
RUST_LOG=info,tower_http=warn,llama-cpp-2=warn
